{
  "name": "thrift-flip",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Thrift Flip - buy junk, restore it, sell it. A cozy hybrid-casual game.",
  "scripts": {
    "dev": "vite",
    "build:web": "vite build --mode web",
    "build:youtube": "vite build --mode youtube && tsx scripts/check-youtube-bundle.ts && tsx scripts/zip-youtube.ts",
    "build:ios": "vite build --mode ios && npx cap sync ios",
    "build:e2e": "E2E=1 vite build --mode youtube --outDir dist-e2e",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build:e2e && playwright test",
    "simulate": "tsx scripts/simulate.ts",
    "screenshots": "tsx scripts/screenshots.ts",
    "check": "npm run lint && npm run typecheck && npm run test:coverage && npm run build:youtube && npm run test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.1",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.11.0",
    "fflate": "^0.8.3",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "phaser": "^4.2.1"
  }
}
